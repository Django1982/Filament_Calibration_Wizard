  "version": "1.3.2",
  "description": "PerfectFit — a local-first guided wizard for calibrating filament profiles for Orca Slicer and Bambu Studio.",
  "license": "AGPL-3.0-only",
  "author": "Aaron Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tayloraaron078-tech/Filament_Calibration_Wizard.git"
  },
  "bugs": {
